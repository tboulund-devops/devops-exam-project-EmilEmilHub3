{
    "stryker-config": {
        "project": "SimpleShop.Api/SimpleShop.Api.csproj",
        "test-projects": [ "SimpleShop.Tests/SimpleShop.Tests.csproj" ],
        "reporters": [ "html", "progress" ],
        "thresholds": {
            "high": 80,
            "low": 50
        },
        "mutate": [
            "SimpleShop.Api/**/*.cs",
            "!SimpleShop.Api/**/Migrations/**",
            "!SimpleShop.Api/**/Program.cs",
            "!SimpleShop.Api/**/*DbContext*.cs"
        ]
    }
}